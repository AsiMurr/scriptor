# Скопируй этот файл в .env и заполни

# Groq API ключ (получить на console.groq.com → API Keys)
GROQ_API_KEY=gsk_...

# Секретный ключ для JWT токенов (придумай 32+ случайных символа)
SECRET_KEY=my-super-secret-key-change-this

# База данных (оставь SQLite для локальной разработки)
DATABASE_URL=sqlite:///./voice_transmite.db
